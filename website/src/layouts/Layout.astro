---
import {href, sourceURL, submitURL, provenance, ratingsAPI, discordURL} from '../lib/catalog.js';
import beam from '../assets/artist/energy-banner-960x160.png';
import Icon from '../components/Icon.astro';
import Scenery from '../components/Scenery.astro';
import '../styles/tokens.css';
import '../styles/site.css';
import '../styles/typography.css';
const {title = 'Legacy of Goku Hub', description = 'Community ROM hacks, fan projects and tools for the Legacy of Goku series.', game, image, imageAlt} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(href(image || 'og-card.png'), Astro.site);
---
<!doctype html>
<html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="description" content={description}/><link rel="canonical" href={canonical}/><meta property="og:url" content={canonical}/><meta property="og:type" content="website"/><meta property="og:site_name" content="Legacy of Goku Hub"/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:image" content={ogImage}/><meta property="og:image:alt" content={image ? imageAlt : 'Legacy of Goku Hub'}/><meta name="twitter:card" content="summary_large_image"/><link rel="icon" type="image/png" href={href('favicon.png')}/><link rel="apple-touch-icon" href={href('apple-touch-icon.png')}/><meta name="color-scheme" content="dark"/><meta name="theme-color" content="#0c1533"/><title>{title}</title></head>
<body><Scenery game={game}/><a class="skip-link" href="#main">Skip to content</a><header class="site-header"><div class="header-inner"><a class="brand" href={href('')} aria-label="Legacy of Goku Hub home"><img class="brand-beam" src={beam.src} alt="" width="960" height="160" fetchpriority="high" decoding="async"/><span class="brand-name">Legacy of Goku <em>Hub</em></span></a>
  <nav class="desktop-nav" aria-label="Main navigation"><a class="active" href={href('#directory')}>Projects</a><a href={submitURL}>Submit</a><a href={sourceURL}><Icon name="github"/> GitHub</a><a href={discordURL} aria-label="Join our Discord"><Icon name="discord"/></a></nav>
  <details class="mobile-nav"><summary aria-label="Open navigation"><Icon name="menu"/></summary><nav aria-label="Mobile navigation"><a href={href('#directory')}>Projects</a><a href={submitURL}>Submit a project</a><a href={sourceURL}>GitHub</a><a href={discordURL} aria-label="Join our Discord">Discord</a></nav></details>
</div></header><slot/><footer class="site-footer"><p>A community home for the Legacy of Goku series.</p><a href={submitURL}>Submit a project</a><a href={sourceURL}>Contribute on GitHub</a><a href={href('how-to-patch/')}>How to patch</a><p>Fan projects. No ROMs hosted.</p>{ratingsAPI && <a href={href('ratings-privacy/')}>Ratings privacy</a>}<p>Unofficial fan site, not affiliated with or endorsed by the owners of Dragon Ball Z or The Legacy of Goku games.</p><a href={submitURL}>Request a correction or removal</a>{provenance.purpose === 'fixture' && <strong class="fixture-notice">ISOLATED DESIGN FIXTURES · Not community listings</strong>}</footer>
{ratingsAPI && <div data-ratings-api={ratingsAPI} hidden></div>}
<script>import '../lib/ratings-client.js';</script>
</body></html>
