---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import '../../styles/submit.css';
import {href, intakeAPI, turnstileKey, listingIndex, statusURL, discordURL} from '../../lib/catalog.js';
const kinds = [
  ['suggest', 'Suggest a project', 'Someone else made it. You only point us to it.'],
  ['add', 'Add my project', 'You made it or you run it.'],
  ['correct', 'Correct a listing', 'Something on a listed project is wrong, or it should be removed.'],
  ['claim', 'Claim a listing', 'You made a listed project and want it marked as yours.']
];
const games = [['', 'Not sure'], ['legacy-of-goku', 'Legacy of Goku'], ['legacy-of-goku-2', 'Legacy of Goku II'], ['buus-fury', 'Buu’s Fury'], ['multiple', 'More than one game']];
const categories = [['', 'Choose one'], ['rom-hack', 'ROM hack'], ['translation', 'Translation'], ['fan-project', 'Fan project'], ['tool', 'Tool'], ['resource', 'Resource']];
const statuses = [['', 'Not sure'], ['released', 'Released'], ['in-development', 'In development'], ['on-hold', 'On hold'], ['discontinued', 'Discontinued']];
const steps = [['form', 'Details'], ['review', 'Check'], ['receipt', 'Sent']];
---
<Layout title="Submit a project | Legacy of Goku Hub" description="Add or suggest a Legacy of Goku ROM hack, fan project or tool. No account needed."><main id="main" class="container submit-main">
  <nav class="breadcrumbs" aria-label="Breadcrumb"><a href={href('')}><Icon name="back"/>All Projects</a><span aria-hidden="true">/</span><span aria-current="page">Submit</span></nav>
  <header class="submit-heading"><h1>Submit a project</h1><p>Tell us about a Legacy of Goku hack, fan project or tool. No account is needed. A person reviews everything before it is listed. AI-assisted projects are welcome. Low-effort projects made mostly by AI are not listed.</p><p class="heading-link">Already sent one? <a href={statusURL}>Check a submission</a></p></header>
  {!intakeAPI && <p class="availability-note" role="note"><strong>Submissions are not open yet.</strong> You can fill in the form to see how it works, but nothing can be sent for now. To ask for a correction or removal today, <a href={discordURL} rel="noopener noreferrer">message us on Discord</a>.</p>}
  <noscript><style is:inline>.script-note{display:none}</style><p class="availability-note" role="note">This form needs JavaScript. Turn it on in your browser, then reload this page.</p></noscript>
  <p class="availability-note script-note" id="script-note" role="note">The form did not start. Reload the page. If it still does not start, try another browser.</p>
  <div data-submit data-api={intakeAPI} data-site-key={turnstileKey} data-status-url={statusURL}>
    <ol class="steps" id="steps" aria-label="Steps">{steps.map(([id, label], i) => <li data-step={id} aria-current={i === 0 ? 'step' : undefined}><span class="step-number">{i + 1}</span>{label}</li>)}</ol>
    <form id="submit-form" class="panel submit-panel" novalidate autocomplete="off">
      <p id="draft-note" class="draft-note" role="status" hidden>We kept what you typed earlier. <button class="link-button" type="button" id="start-over">Start over</button></p>
      <div id="error-summary" class="error-summary" role="alert" tabindex="-1" hidden><h2>Please check these fields</h2><ul></ul></div>
      <fieldset class="kind-group"><legend>What would you like to do?</legend><div class="kind-options">{kinds.map(([value, title, text], i) => <label class="kind-option"><input type="radio" name="kind" value={value} checked={i === 0}/><span class="kind-title">{title}</span><span class="kind-text">{text}</span></label>)}</div><p class="hint kind-hint" id="kind-hint" aria-hidden="true"></p></fieldset>
      <div class="field" data-field="listing_id" data-show="correct claim" data-required="correct claim" hidden><label for="f-listing_id">Which listing?<span class="req" aria-hidden="true">Required</span></label><select id="f-listing_id" name="listing_id" aria-describedby="e-listing_id"><option value="">Choose a project</option>{listingIndex.map(item => <option value={item.id}>{item.title}</option>)}</select><p class="error" id="e-listing_id" hidden></p><div id="current" class="current-box" hidden><h2 class="current-title">Listed now</h2><dl id="current-list"></dl><p class="hint"><a id="current-link" href={href('')} target="_blank" rel="noopener">Open the listing in a new tab</a></p></div></div>
      <div data-show="add suggest correct">
        <p class="hint correct-lead" data-show="correct" hidden>Fill in only what should change. Leave the rest empty to keep it as listed.</p>
        <div class="field" data-field="url" data-required="add suggest"><label for="f-url">Project address<span class="req" aria-hidden="true">Required</span></label><p class="hint" id="h-url">Where people can find the project: a GitHub, GitLab or Codeberg page, a forum thread, a website or a ROM hacking site.</p><input id="f-url" name="url" type="url" inputmode="url" placeholder="https://" data-address aria-describedby="h-url e-url duplicate"/><p class="error" id="e-url" hidden></p><div id="duplicate" class="duplicate-note" role="status" hidden></div><div class="prefill" id="prefill" hidden><button class="button secondary" type="button" id="prefill-button">Fill in name and description from the page</button><p class="hint" id="prefill-note" role="status"></p></div><label class="inline-check" data-show="add suggest"><input type="checkbox" name="no_page" id="f-no_page"/> There is no web page for this project</label></div>
        <div class="field" data-field="title" data-required="add suggest"><label for="f-title">Project name<span class="req" aria-hidden="true">Required</span></label><p class="hint" id="h-title">The name its creator uses.</p><input id="f-title" name="title" type="text" maxlength="100" aria-describedby="h-title e-title"/><p class="error" id="e-title" hidden></p></div>
        <div class="field" data-field="category" data-required="add suggest"><label for="f-category">What is it?<span class="req" aria-hidden="true">Required</span></label><p class="hint" id="h-category">This decides where it appears in the directory.</p><select id="f-category" name="category" aria-describedby="h-category e-category">{categories.map(([value, label]) => <option value={value}>{label}</option>)}</select><p class="error" id="e-category" hidden></p></div>
        <div class="field-row"><div class="field" data-field="game"><label for="f-game">Base game</label><select id="f-game" name="game" aria-describedby="e-game">{games.map(([value, label]) => <option value={value}>{label}</option>)}</select><p class="error" id="e-game" hidden></p></div>
        <div class="field" data-field="status"><label for="f-status">Status</label><select id="f-status" name="status" aria-describedby="e-status">{statuses.map(([value, label]) => <option value={value}>{label}</option>)}</select><p class="error" id="e-status" hidden></p></div></div>
        <div class="field" data-field="creator"><label for="f-creator">Creator or team</label><p class="hint" id="h-creator">Leave empty if you are not sure.</p><input id="f-creator" name="creator" type="text" maxlength="100" aria-describedby="h-creator e-creator"/><p class="error" id="e-creator" hidden></p></div>
        <div class="field" data-field="description" data-required="add suggest"><label for="f-description">Short description<span class="req" aria-hidden="true">Required</span></label><p class="hint" id="h-description">Two or three sentences about what it changes or adds. At least 20 characters.</p><textarea id="f-description" name="description" rows="4" maxlength="2000" aria-describedby="h-description e-description description-count"></textarea><p class="counter" id="description-count" aria-live="off">0 / 2000</p><p class="error" id="e-description" hidden></p></div>
        <div class="field" data-field="artwork"><label for="f-artwork">Images</label><p class="hint" id="h-artwork">We cannot take uploads. Paste links to PNG, JPG or WebP pictures, one per line, up to four. The first becomes the cover. To get a link, right-click a picture and choose Copy image address. A moderator reviews each picture before it is shown.</p><textarea id="f-artwork" name="artwork" rows="3" aria-describedby="h-artwork e-artwork"></textarea><p class="error" id="e-artwork" hidden></p><div class="prefill"><button class="button secondary" type="button" id="art-button">Preview images</button><p class="hint" id="art-note" role="status"></p></div><ul id="art-preview" class="art-preview" hidden></ul></div>
      </div>
      <div class="field" data-field="note" data-required="claim"><label for="f-note"><span id="note-label">Anything else we should know?</span><span class="req" aria-hidden="true" hidden>Required</span></label><p class="hint" id="h-note">Only moderators can read this.</p><textarea id="f-note" name="note" rows="3" maxlength="500" aria-describedby="h-note e-note"></textarea><p class="error" id="e-note" hidden></p></div>
      <details id="more" class="more" data-show="add suggest correct"><summary>Download page and community links (optional)</summary>
        <div class="field" data-field="patch_url"><label for="f-patch_url">Patch or download page</label><p class="hint" id="h-patch_url">A link to the patch or the page where it is shared. We never host game files. Moderators check every link.</p><input id="f-patch_url" name="patch_url" type="url" inputmode="url" placeholder="https://" data-address aria-describedby="h-patch_url e-patch_url"/><p class="error" id="e-patch_url" hidden></p></div>
        <fieldset class="field" data-field="links"><legend>Community links</legend><p class="hint" id="h-links">A Discord invite, a video or a thread. Up to two.</p>{[0, 1].map(i => <div class="link-row"><label class="sr-only" for={`f-link-label-${i}`}>Link {i + 1} name</label><input id={`f-link-label-${i}`} name={`link_label_${i}`} type="text" maxlength="32" placeholder="Name, such as Discord" aria-describedby="h-links e-links"/><label class="sr-only" for={`f-link-url-${i}`}>Link {i + 1} address</label><input id={`f-link-url-${i}`} name={`link_url_${i}`} type="url" inputmode="url" placeholder="https://" data-address aria-describedby="h-links e-links"/></div>)}<p class="error" id="e-links" hidden></p></fieldset>
      </details>
      <div class="trap" aria-hidden="true"><label for="f-hp">Leave this field empty</label><input id="f-hp" name="hp_check" type="text" tabindex="-1" autocomplete="off"/></div>
      <div class="actions"><button class="button primary" type="submit" id="review-button" disabled>Review your submission<Icon name="arrow"/></button></div>
    </form>
    <section id="review" class="panel submit-panel" aria-labelledby="review-title" hidden><h2 id="review-title" class="panel-title" tabindex="-1">Check your submission</h2><p class="hint">Nothing has been sent yet. Make sure this looks right.</p><dl id="review-list"></dl><p class="hint" id="human-hint" hidden>Complete the check below, then send.</p><div id="human-check" class="human-check"></div><p id="send-status" class="send-status" role="status" aria-live="polite"></p><div class="actions"><button class="button secondary" type="button" id="edit-button"><Icon name="back"/>Edit</button><button class="button primary" type="button" id="send-button">Send submission<Icon name="arrow"/></button></div></section>
    <section id="receipt" class="panel submit-panel" aria-labelledby="receipt-title" hidden><h2 id="receipt-title" class="panel-title" tabindex="-1">Submission received</h2><p id="receipt-message"></p><div class="receipt-box"><span class="receipt-label">Your receipt</span><code id="receipt-code"></code><div class="receipt-actions"><button class="button secondary" type="button" id="save-receipt">Save receipt as a file</button><button class="button secondary" type="button" id="copy-receipt">Copy receipt</button></div><p class="hint" id="receipt-note" role="status"></p></div><p class="hint">Save this code. It is the only way to see replies from the moderators, and we cannot recover it for you. Anyone who has it can see the status.</p><div id="claim-steps" class="claim-steps" hidden><h3>Prove it is your project</h3><p>Add this exact text somewhere on your project page, such as the description or a post, then keep it there until a moderator confirms:</p><code id="claim-challenge"></code><p class="hint">If you cannot add the text, a moderator will ask you another way on the status page.</p></div><div class="actions"><a class="button secondary" href={href('submit/')}>Submit another</a><a class="button primary" id="status-button" href={statusURL}>Check status<Icon name="arrow"/></a></div></section>
  </div>
  <script type="application/json" id="listing-index" set:html={JSON.stringify(listingIndex).replaceAll('<', '\\u003c')}/>
</main><script>import '../../lib/submit-client.js';</script></Layout>
