---
import Layout from '../layouts/Layout.astro';
import Badges from '../components/Badges.astro';
import Rating from '../components/Rating.astro';
import Icon from '../components/Icon.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ProjectArtwork from '../components/ProjectArtwork.astro';
import PortraitFrame from '../components/PortraitFrame.astro';
import Ball from '../components/Ball.astro';
import {projectSummary} from '../lib/summary.js';
import {CATEGORIES} from '../lib/submission.js';
import {catalog, href, projectURL, submitURL, rating, featuredLabel, projectActions, formatDate, names} from '../lib/catalog.js';
const featured = catalog.projects.find(p => p.featured);
const featuredAction = featured && projectActions(featured)[0];
const projects = catalog.sort.name.map(id => catalog.projects.find(p => p.id === id));
const tabLabels = {'rom-hack': 'ROM Hacks', translation: 'Translations', 'fan-project': 'Fan Projects', tool: 'Tools', resource: 'Resources'};
const tabs = CATEGORIES.map(id => ({id, label: tabLabels[id] || names[id], count: projects.filter(p => p.category === id).length}));
const recentUpdates = [...catalog.projects]
  .filter(project => project.last_updated && !Number.isNaN(Date.parse(project.last_updated)))
  .sort((a, b) => Date.parse(b.last_updated) - Date.parse(a.last_updated) || a.title.localeCompare(b.title))
  .slice(0, 3);
---
<Layout title="Legacy of Goku Hub | ROM hacks, translations and tools" game={featured?.game}><main id="main">
  {catalog.projects.length > 0 && <p class="site-tagline">{catalog.projects.length} ROM hacks, translations and tools for the GBA Legacy of Goku trilogy. No ROMs hosted.</p>}
  <section class:list={['spotlight', {'empty-spotlight': !featured}]} aria-labelledby="spotlight-title"><div class="spotlight-inner">
    {featured ? <><a class="spotlight-art" href={projectURL(featured)} tabindex="-1" aria-hidden="true"><ProjectArtwork src={featured.cover ? href(featured.cover) : null} loading="eager" fetchpriority="high"/><PortraitFrame/></a><div class="spotlight-copy"><span class="featured-label">{featuredLabel(featured)}</span><h1 id="spotlight-title">{featured.title}</h1><Badges project={featured}/><p class="spotlight-description">{projectSummary(featured.description)}</p><Rating {...rating(featured)} projectId={featured.id}/><div class="hero-actions"><a class="button primary" href={projectURL(featured)}><Icon name="play"/>View Project</a>{featuredAction && <a class="button secondary" href={featuredAction.url} rel="noopener noreferrer"><Icon name={featuredAction.id === 'repository' ? 'github' : featuredAction.icon}/>{featuredAction.label}</a>}</div></div></> : <><div class="empty-art" aria-hidden="true"><span class="empty-balls">{[1,2,3,4,5,6,7].map(n => <Ball number={n} muted/>)}</span><span class="empty-art-title">Seven slots.<br/><em>None filled yet.</em></span><span class="empty-art-caption">Legacy of Goku · LoG II · Buu’s Fury</span></div><div class="spotlight-copy"><span class="featured-label">Community projects</span><h1 id="spotlight-title">Legacy of Goku Community Directory</h1><p class="spotlight-description">{catalog.projects.length ? "Browse community ROM hacks, fan projects, and development resources in the directory below." : "The public directory has no approved projects yet. ROM hacks, tools, fan projects, and resources will appear after review."}</p><p class="quiet">Project submissions are reviewed before publication.</p><div class="hero-actions"><a class="button primary" href={submitURL}><Icon name="code"/>Submit a project</a><a class="button secondary" href="#directory">Explore the directory<Icon name="arrow"/></a></div></div></>}
  </div></section>
  {recentUpdates.length > 0 && <section class="recent-updates container" aria-labelledby="recent-updates-title"><div class="recent-heading"><h2 id="recent-updates-title">Latest Listing Updates</h2><a href="#directory">Browse the directory <Icon name="arrow"/></a></div><div class="recent-list">{recentUpdates.map(project => <a class="recent-project" href={projectURL(project)}><span class="recent-project-title">{project.title}</span><span class="recent-project-category">{names[project.category]}</span><time datetime={project.last_updated}>Listing updated {formatDate(project.last_updated)}</time></a>)}</div></section>}
  <section id="directory" class="directory container" aria-labelledby="directory-title"><div class="directory-heading"><h2 id="directory-title">Project Directory</h2><p>ROM hacks, enhancements, and tools for the Legacy of Goku series.</p></div>
  <nav class="category-tabs" aria-label="Project categories">{tabs.map((tab, i) => <a href={`?category=${tab.id}#directory`} data-category={tab.id} aria-current={i === 0 ? 'true' : undefined}>{tab.label} <span class="tab-count">{tab.count}<span class="sr-only"> {tab.count === 1 ? 'project' : 'projects'}</span></span></a>)}</nav>
  <form class="directory-controls" role="search" aria-label="Find projects"><div class="search-field"><Icon name="search"/><label class="sr-only" for="search">Search projects</label><input id="search" name="q" type="search" placeholder="Search projects…" autocomplete="off"/></div><div class="filter-controls"><label><span class="sr-only">Base game</span><select aria-label="Base game" id="game" name="game"><option value="">All games</option><option value="legacy-of-goku">LoG 1</option><option value="legacy-of-goku-2">LoG II</option><option value="buus-fury">Buu’s Fury</option><option value="multiple">Multiple games</option></select></label><label><span class="sr-only">Development status</span><select aria-label="Development status" id="status" name="status"><option value="">All statuses</option><option value="released">Released</option><option value="in-development">In Development</option><option value="on-hold">On Hold</option><option value="discontinued">Discontinued</option></select></label></div><label class="sort-label"><span class="sr-only">Sort projects</span><select aria-label="Sort projects" id="sort" name="sort"><option value="name">Sort by: Name</option><option value="release">Sort by: Release date</option><option value="updated">Sort by: Listing updated</option></select></label></form>
  <p id="result-count" class="sr-only" role="status" aria-live="polite">{projects.length} projects</p><div class="project-grid">{projects.map(project => <ProjectCard project={project}/>)}</div>
  <div id="no-results" class="empty-directory" hidden={projects.length > 0}><span class="empty-symbol" aria-hidden="true"><Ball number={4} muted/></span><h3 id="no-results-title">{projects.length ? 'No matching projects' : 'No approved projects yet'}</h3><p id="no-results-hint">{projects.length ? 'Try another search or clear your filters.' : 'Listings will appear after project submissions are reviewed and approved.'}</p>{projects.length ? <button class="button secondary" type="button" data-clear-filters>Clear filters</button> : <a class="button primary" href={submitURL}>Submit your project<Icon name="arrow"/></a>}</div>
  <noscript><p class="quiet">All projects are shown. Enable JavaScript to browse by category, search, filter and sort.</p></noscript></section>
</main><script src="../lib/directory.js"/></Layout>
