---
import Layout from '../../layouts/Layout.astro';
import Badges from '../../components/Badges.astro';
import Rating from '../../components/Rating.astro';
import RatingSelector from '../../components/RatingSelector.astro';
import Icon from '../../components/Icon.astro';
import {catalog, href, fullGame, names, rating, formatDate, formatSize} from '../../lib/catalog.js';
export function getStaticPaths() {return catalog.projects.map(project => ({params:{id:project.id},props:{project}}));}
const {project} = Astro.props;
const downloadable = project.release && project.availability === 'available';
---
<Layout title={`${project.title} | Legacy of Goku Hub`} description={project.description}><main id="main" class="detail-main container">
  <nav class="breadcrumbs" aria-label="Breadcrumb"><a href={href('#directory')}><Icon name="back"/>All Projects</a><span aria-hidden="true">/</span><span aria-current="page">{project.title}</span></nav>
  <section class="detail-hero" aria-labelledby="project-title"><img class="detail-art" src={href(project.cover)} alt={`${project.title} project artwork`} width="640" height="360" fetchpriority="high"/><div class="detail-intro">{project.featured && <span class="featured-label">★ &nbsp; Featured Game</span>}<h1 id="project-title">{project.title}</h1><p class="detail-developer">by {project.developer}</p><Badges project={project}/><p class="detail-description">{project.description}</p><div class="hero-actions">{downloadable && <a class="button secondary" href={project.release.download_url} rel="noopener noreferrer"><Icon name="github"/>Download on GitHub</a>}<a class="button primary" href={project.repository} rel="noopener noreferrer"><Icon name="code"/>View Repository</a></div></div>
  {project.release && <aside class="release-panel panel" aria-labelledby="release-title"><h2 class="panel-title" id="release-title">Release Info</h2><dl><div><dt>Version</dt><dd><a href={`${project.repository}/releases/tag/${encodeURIComponent(project.release.version)}`} rel="noopener noreferrer">{project.release.version}</a></dd></div><div><dt>File Size</dt><dd>{formatSize(project.release.file_size)}</dd></div><div><dt>Release Date</dt><dd><time datetime={project.release.release_date}>{formatDate(project.release.release_date)}</time></dd></div></dl></aside>}
  </section>
  {project.availability !== 'available' && <p class="availability-note" role="note">{project.archived ? 'This repository is archived.' : 'This project is temporarily unavailable.'} Saved metadata is shown; downloads are unavailable. <a href={project.repository}>Check the repository</a>.</p>}
  <section class="detail-rating panel" aria-label="Community ratings"><div class="community-rating"><h2 class="panel-title">Community Rating</h2><Rating {...rating(project)}/></div><RatingSelector/></section>
  <div class="detail-columns"><div class="detail-content"><section class="panel about" aria-labelledby="about-title"><h2 class="panel-title" id="about-title">About</h2><p class="description-box">{project.description}</p></section>
  <section class="panel gallery-panel" aria-labelledby="screenshots-title"><h2 class="panel-title" id="screenshots-title">Screenshots</h2>{project.screenshots.length ? <div class="screenshot-gallery">{project.screenshots.map((image,i)=><a href={href(image)} aria-label={`Open ${project.title} screenshot ${i+1}`}><img src={href(image)} alt={`${project.title} screenshot ${i+1}`} width="480" height="320" loading="lazy" decoding="async"/></a>)}</div> : <p class="quiet">No screenshots have been provided yet.</p>}</section>
  </div><aside class="panel project-information"><h2 class="panel-title">Project Details</h2><dl><div><dt>Repository</dt><dd><a href={project.repository} rel="noopener noreferrer">{project.repository.replace('https://github.com/','')}<Icon name="external" size={16}/></a></dd></div><div><dt>Game</dt><dd>{fullGame[project.game]}</dd></div><div><dt>Category</dt><dd>{names[project.category]}</dd></div><div><dt>Status</dt><dd><span class:list={['badge',project.status]}>{names[project.status]}</span></dd></div><div><dt>Last updated</dt><dd><time datetime={project.last_updated}>{formatDate(project.last_updated)}</time></dd></div>{project.ownership && <div><dt>Representation</dt><dd>{project.ownership.representation_verified ? 'Team representation verified' : 'Repository listing; team representation not verified'}</dd></div>}</dl>
  {(downloadable || project.links?.length) && <section class="approved-links" aria-labelledby="links-title"><h2 class="panel-title" id="links-title">Approved Links</h2><ul>{downloadable && <li><a href={project.release.download_url} rel="noopener noreferrer"><Icon name="download"/>Download (GitHub Releases)<Icon name="external" size={17}/></a></li>}{project.links?.map(link=><li><a href={link.url} rel="noopener noreferrer">{link.label}<Icon name="external" size={17}/></a></li>)}</ul></section>}
  {project.release?.sha256 && <details class="checksum"><summary>SHA-256 checksum</summary><code>{project.release.sha256}</code></details>}
  </aside></div>
</main></Layout>
