---
import Ball from './Ball.astro';
---
<div class="rating-selector"><h2 class="panel-title" id="rating-selector-title">Preview only · not saved</h2>
<fieldset aria-labelledby="rating-selector-title"><div class="rating-options">{Array.from({length:7},(_,i)=><label class="rating-option"><input type="radio" name="rating-preview" autocomplete="off" value={i+1} aria-label={`${i+1} ${i === 0 ? 'Dragon Ball' : 'Dragon Balls'}`}/><span class="rating-choice"><Ball number={i+1}/></span></label>)}</div></fieldset></div>
<script>
  document.querySelectorAll('.rating-selector').forEach(selector => {
    window.addEventListener('pageshow', () => {
      selector.querySelectorAll('input').forEach(input => {input.checked = false;});
    });
  });
</script>
