---
import PortraitFrame from './PortraitFrame.astro';
import Ball from './Ball.astro';
const {framed = false, src, width = 640, height = 360, alt = '', class: className = '', loading = 'lazy', fetchpriority, game} = Astro.props;
const stars = {'legacy-of-goku': 1, 'legacy-of-goku-2': 2, 'buus-fury': 3}[game] || 7;
---
<span class:list={['project-artwork',className]}>{src && <img src={src} alt={alt} width={width} height={height} loading={loading} fetchpriority={fetchpriority} decoding="async"/>}<span class="artwork-unavailable" hidden={!!src}>{src ? 'Project artwork unavailable' : <><Ball number={stars}/><span class="sr-only">Project artwork not provided</span></>}</span>{framed && <PortraitFrame/>}</span>
<script>
  document.querySelectorAll('.project-artwork').forEach(frame=>{
    const image=frame.querySelector('img');
    if(!image) return;
    const unavailable=()=>{image.hidden=true;frame.querySelector('.artwork-unavailable').hidden=false;};
    image.addEventListener('error',unavailable,{once:true});
    if(image.complete && !image.naturalWidth) unavailable();
  });
</script>
