---
const {name, size = 22} = Astro.props;
// Pixel icons on a 12x12 grid: each string is one row, '#' is a filled pixel.
const art = {
  search: ['..####......', '.#....#.....', '#......#....', '#......#....', '#......#....', '#......#....', '.#....#.....', '..#####.....', '......###...', '.......###..', '........###.', '.........##.'],
  download: ['.....##.....', '.....##.....', '.....##.....', '.....##.....', '..########..', '...######...', '....####....', '.....##.....', '............', '#..........#', '#..........#', '############'],
  arrow: ['............', '......#.....', '......##....', '......###...', '##########..', '###########.', '##########..', '......###...', '......##....', '......#.....', '............', '............'],
  back: ['............', '.......##...', '......##....', '.....##.....', '....##......', '...##.......', '...##.......', '....##......', '.....##.....', '......##....', '.......##...', '............'],
  menu: ['............', '.##########.', '.##########.', '............', '............', '.##########.', '.##########.', '............', '............', '.##########.', '.##########.', '............'],
  code: ['............', '.......#....', '...#...#.#..', '..#...#...#.', '.#....#....#', '#.....#....#', '.#...#.....#', '..#..#....#.', '...#.#...#..', '....#.......', '............', '............'],
  external: ['......######', '.........###', '........##.#', '.#####.##..#', '.#....##....', '.#...##.....', '.#........#.', '.#........#.', '.#........#.', '.#........#.', '.##########.', '............'],
  github: ['............', '.#........#.', '.##......##.', '.##########.', '############', '##.##..##.##', '##.##..##.##', '############', '.##########.', '..###..###..', '..##....##..', '............'],
  discord: ['............', '............', '..##....##..', '.##########.', '############', '############', '###..##..###', '###..##..###', '############', '.###....###.', '.##......##.', '............'],
  play: ['............', '..##........', '..####......', '..######....', '..########..', '..##########', '..##########', '..########..', '..######....', '..####......', '..##........', '............']
};
const rows = art[name] || art.arrow;
if (rows.length !== 12 || rows.some(row => row.length !== 12)) throw new Error(`Icon ${name} is not 12x12`);
const d = rows.flatMap((row, y) => [...row].map((cell, x) => cell === '#' ? `M${x} ${y}h1v1h-1z` : '')).join('');
---
<svg width={size} height={size} viewBox="0 0 12 12" fill="currentColor" shape-rendering="crispEdges" aria-hidden="true"><path d={d}/></svg>
