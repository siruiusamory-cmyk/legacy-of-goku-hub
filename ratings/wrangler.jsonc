{
  "name": "loghub-ratings",
  "main": "worker.js",
  "compatibility_date": "2026-07-02",
  "workers_dev": false,
  "routes": [{"pattern": "ratings.legacyofgokuhub.com", "custom_domain": true}],
  "preview_urls": false,
  "observability": {
    "enabled": false
  },
  "vars": {
    "RATINGS_ENABLED": "false",
    "SITE_ORIGIN": "https://legacyofgokuhub.com",
    "API_ORIGIN": "https://ratings.legacyofgokuhub.com"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "loghub-ratings",
      "database_id": "a90fe4fa-dc7f-4b9a-8d26-51c2e968f72c",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": [
      "*/10 * * * *"
    ]
  }
}
