{
  "name": "loghub-ratings",
  "main": "worker.js",
  "compatibility_date": "2026-07-02",
  "workers_dev": false,
  "preview_urls": false,
  "observability": {"enabled": false},
  "vars": {
    "RATINGS_ENABLED": "false",
    "SITE_ORIGIN": "https://loghub.pages.dev",
    "API_ORIGIN": "https://ratings-not-configured.invalid"
  },
  "d1_databases": [{"binding": "DB", "database_name": "loghub-ratings", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations"}],
  "triggers": {"crons": ["*/10 * * * *"]}
}
